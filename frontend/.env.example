# Left empty on purpose for local dev: requests stay relative and go through the
# Vite dev proxy (see vite.config.ts) on the same origin as the page, which avoids
# CORS entirely — the backend has no CORSMiddleware configured. Only set this to an
# absolute URL (e.g. http://localhost:8000) if the backend's CORS is set up to allow
# the frontend's origin.
VITE_API_BASE_URL=
VITE_API_PREFIX=/api/v1
